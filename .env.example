# Complete reference: CONFIGURATION.md
# Copy to .env. Set an access password and your HTTPS upstream API credentials.
ACCESS_KEY=
DEFAULT_API_URL=
DEFAULT_API_KEY=

# HTTPS is the default. For direct HTTP access, uncomment both lines:
# ACCESS_COOKIE_SECURE=false
# ACCESS_KEY_COOKIE_NAME=gpt_image_access

# Optional: application image and upstream defaults.
# GPT_IMAGE_PANEL_IMAGE=ghcr.io/z1rconium/gpt-image-linux:v1.7.18
# DEFAULT_API_PATH=/v1/images/generations
# DEFAULT_RESPONSES_MODEL=gpt-5.4
# DEFAULT_UPSTREAM_SOCKS5_PROXY=

# Optional: reverse proxy and inbound security.
# PUBLIC_ORIGIN=https://panel.example.com
# ALLOWED_HOSTS=panel.example.com
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_IPS=
# IP_ALLOWLIST=
# TURNSTILE_ENABLED=false
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: optimizer and assistant.
# PROMPT_OPTIMIZER_ENABLED=false
# PROMPT_OPTIMIZER_API_URL=
# PROMPT_OPTIMIZER_API_KEY=
# PROMPT_OPTIMIZER_MODEL=gpt-4o-mini
# PROMPT_OPTIMIZER_TIMEOUT_SECONDS=60
# AI_ASSISTANT_ENABLED=true
# AI_ASSISTANT_VISION_MODEL=gpt-4o-mini

# Optional: R2-compatible storage and NodeImage.
# R2_BACKUP_ENABLED=false
# R2_ENDPOINT_URL=
# R2_BUCKET_NAME=
# R2_REGION=auto
# R2_KEY_PREFIX=gallery/
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_SYNC_INTERVAL_HOURS=0
# NODEIMAGE_API_KEY=

# Optional: capacity and worker settings.
# MAX_FILE_SIZE_MB=50
# MAX_ACTIVE_GENERATE_JOBS=2
# MAX_QUEUED_GENERATE_JOBS=20
# GRANIAN_WORKERS=1

# Optional: secret registry, CDN, metrics and cost rates.
# SECRET_REGISTRY_JSON=
# PUBLIC_IMAGE_BASE_URL=
# PUBLIC_THUMBNAIL_BASE_URL=
# CDN_SIGNING_SECRET=
# CDN_URL_TTL_SECONDS=300
# ENABLE_METRICS=false
# IMAGE_COST_RATES_JSON=
