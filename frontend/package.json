{
  "name": "gpt-image-panel-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "check:worker-build": "node scripts/check-worker-build.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production-e2e.config.ts",
    "test:e2e:perf": "RUN_PERFORMANCE_TESTS=true playwright test",
    "test:perf:production": "playwright test --config playwright.perf.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^25.6.2",
    "lucide-svelte": "1.0.1",
    "postcss": "^8.5.25",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge": "4.1.1"
  },
  "dependencies": {
    "marked": "18.0.14",
    "ogl": "^1.0.11"
  }
}
